# Copy this file to .env and fill in real values. Never commit .env.

# Port the server listens on
PORT=4000

# Comma-separated list of origins allowed to call the API.
# Use * only in local development.
ALLOWED_ORIGINS=http://localhost:4000,http://127.0.0.1:5500

# Secret used to sign login sessions (JWTs). Set this to a long random
# string in production — anyone with this value could forge logins.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-this-with-a-long-random-string

# --- Admin access ------------------------------------------------------
# Comma-separated list of email addresses that should have access to the
# admin dashboard (/admin.html). Anyone who signs up or logs in with one
# of these emails is automatically granted the "admin" role.
# Example: ADMIN_EMAILS=you@jrextech.com,partner@jrextech.com
ADMIN_EMAILS=

# --- Email notifications (optional) ---------------------------------
# If left blank, contact form submissions are still saved to the database,
# but no email is sent.
# Works with Gmail (use an App Password, not your normal password),
# or any SMTP provider (SendGrid, Mailgun, Zoho, etc).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
CONTACT_TO_EMAIL=info@jrextech.com
CONTACT_FROM_EMAIL=your-email@gmail.com
